
transcode_ac3() {
    filename=$(basename -s .mkv $1)
    ffmpeg -i $1 -c:v copy -c:a ac3 -q:a 448 $filename-ac3.mkv
}

if [[ -f /usr/bin/xsel ]]; then
    alias pbcopy='xsel --clipboard --input'
    alias pbpaste='xsel --clipboard --output'
fi

# work
alias gh_jlintz='ssh-add -D; ssh-add ~/Dropbox/keys/github'
alias gh_tsiq='ssh-add -D; ssh-add ~/keys/id_github_tsiq'

if [[ `uname` == 'Darwin' ]]; then
    alias ls='gls --color'
fi
